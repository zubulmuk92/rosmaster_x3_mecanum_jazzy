# Vue RViz de navigation du X3 : panneau Nav2, outil Nav2 Goal,
# contour réel du robot, points de passage. Lidar sur /scan.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
    Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: false
      Marker Scale: 0.3
      Value: false
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Size (m): 0.03
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 255; 40; 40
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Carte
      Enabled: true
      Topic:
        Value: /map
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Alpha: 1
      Color Scheme: map
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Zone à éviter (globale)
      Enabled: true
      Topic:
        Value: /global_costmap/costmap
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Alpha: 0.3
      Color Scheme: costmap
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Zone à éviter (locale)
      Enabled: true
      Topic:
        Value: /local_costmap/costmap
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Alpha: 0.3
      Color Scheme: costmap
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Chemin prévu
      Enabled: true
      Topic:
        Value: /plan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color: 0; 220; 0
      Line Style: Billboards
      Line Width: 0.03
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Trajectoire immédiate
      Enabled: true
      Topic:
        Value: /local_plan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color: 0; 150; 255
      Line Style: Billboards
      Line Width: 0.03
      Value: true
    - Class: rviz_default_plugins/Polygon
      Name: Contour du robot
      Enabled: true
      Topic:
        Value: /local_costmap/published_footprint
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color: 255; 255; 0
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Points de passage
      Enabled: true
      Topic:
        Value: /waypoints
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    # Caméra de profondeur (simulation avec camera:=true, ou vrai robot) : rien sans caméra
    - Class: rviz_default_plugins/PointCloud2
      Name: Profondeur (nuage)
      Enabled: true
      Topic:
        Value: /camera/depth/points
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
      Decay Time: 0
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Profondeur (image)
      Enabled: false
      Topic:
        Value: /camera/depth/image_raw
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Normalize Range: true
      Value: false
    - Class: rviz_default_plugins/Image
      Name: Caméra couleur
      Enabled: false
      Topic:
        Value: /camera/color/image_raw
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Value: false
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: nav2_rviz_plugins/GoalTool
    - Class: rviz_default_plugins/PublishPoint
  Value: true
  Views:
    Current:
      # Vue de dessus fixe, centrée sur turtlebot3_world (le repère map part du point de départ du robot)
      Class: rviz_default_plugins/TopDownOrtho
      Angle: 0
      Scale: 120
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz_default_plugins)
      X: 2
      Y: 0.5
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
